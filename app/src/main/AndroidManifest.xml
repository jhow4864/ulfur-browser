<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only needed to save downloads to the public Downloads folder on Android 8/9 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Download progress notification + keeping downloads alive in the background -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- In-app updater (update/Updater.kt): install new releases downloaded from GitHub -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 2.12.1: only requested when a site the user allowed asks for camera / mic / location (never at launch). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".BeastApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Beast"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Launcher entry lives on the IconAlias* aliases below, so MainActivity itself is never disabled
                 (http/https VIEW, default-browser role and pinned shortcuts all target it). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Issue #34: home-screen web apps. NOT exported: pinned shortcuts are launched as Ulfur itself, so other apps
             can't open a chromeless window on a URL of their choosing. Explicit intents only. Document mode keyed on a per-app data URI gives each app its own task and recents card. -->
        <activity
            android:name=".webapp.WebAppActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:documentLaunchMode="intoExisting"
            android:exported="false"
            android:persistableMode="persistNever"
            android:resizeableActivity="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />
        <receiver
            android:name=".webapp.PinResultReceiver"
            android:exported="false" />

        <!-- 2.8 alternate app icons: one launcher alias per colourway (disabled until AppIcon.apply). -->
        <activity-alias
            android:name=".ui.IconAliasDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasBloodMoon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blood_moon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blood_moon_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasFrost"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_frost"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_frost_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasToxic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_toxic"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_toxic_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasEmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ember"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ember_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasFullMoon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_full_moon"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_full_moon_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gold"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_gold_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_sakura_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".ui.IconAliasGhost"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ghost"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_ghost_round"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_BROWSER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!-- 2.9: theme-pack preview. Exported so a .ulfurtheme opened from a file manager lands here (content:// only since 2.9.1); the file is
             untrusted and fully validated (ThemePackParser) before anything is shown, and nothing applies until Apply. -->
        <activity
            android:name=".ui.PhotoThemeActivity"
            android:exported="false"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.ThemePackPreviewActivity"
            android:exported="true"
            android:parentActivityName=".ui.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.ulfur.theme+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.ulfurtheme" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.DownloadsActivity"
            android:exported="false"
            android:label="Downloads"
            android:launchMode="singleTop"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.PrivateVideoActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Beast"
            android:parentActivityName=".ui.PrivateDownloadsActivity" />

        <activity
            android:name=".ui.PrivateDownloadsActivity"
            android:exported="false"
            android:label="Private downloads"
            android:parentActivityName=".ui.DownloadsActivity" />

        <activity
            android:name=".ui.SitePermissionsActivity"
            android:exported="false"
            android:label="@string/site_perms_title" />
        <activity
            android:name=".ui.FiltersActivity"
            android:exported="false"
            android:label="@string/filters_title" />

        <activity
            android:name=".ui.PasswordsActivity"
            android:exported="false"
            android:label="Passwords"
            android:parentActivityName=".ui.SettingsActivity" />

        <activity
            android:name=".ui.ReadingListActivity"
            android:exported="false"
            android:label="Reading list"
            android:parentActivityName=".ui.MainActivity" />

        <service
            android:name=".downloads.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- In-app updater: PackageInstaller session results -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 2.10 (Ulfur #1): decrypts private downloads into a pipe for open/share; grant-only access. -->
        <!-- 2.11.2: no WorkManager auto-init in a ContentProvider (it ran before safe start and crashed every launch
             in 2.11.0/2.11.1). BeastApp is a Configuration.Provider; WorkManager starts on first use, after safe start. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name=".downloads.PrivateVaultProvider"
            android:authorities="${applicationId}.privatevault"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 2.10 (Ulfur #2): saved logins for other apps, matched by signing certificate; biometric/PIN per fill. -->
        <service
            android:name=".autofill.UlfurAutofillService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data android:name="android.autofill" android:resource="@xml/ulfur_autofill_service" />
        </service>

        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Beast" />

        <!-- 2.3.5: home-screen Speed Dial widget -->
        <receiver
            android:name=".widget.SpeedDialWidget"
            android:exported="true"
            android:label="@string/widget_speed_dial">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/beast_widget_info" />
        </receiver>
    </application>
</manifest>
