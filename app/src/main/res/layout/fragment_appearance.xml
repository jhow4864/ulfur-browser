<?xml version="1.0" encoding="utf-8"?>
<!-- 2.8 Settings > Appearance (Designer's SPEC.md "Theme picker"). Colours are set in AppearanceFragment.bind(). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/appearanceRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Soft accent wash at the top of the screen (accent at 8%), as in the mockups. -->
    <View
        android:id="@+id/accentWash"
        android:layout_width="match_parent"
        android:layout_height="280dp" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/appearanceScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/appearanceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- ============================================================ LIVE PREVIEW -->
            <include android:id="@+id/headerPreview" layout="@layout/view_section_header" />

            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Mini new-tab page, 124×218 -->
                <LinearLayout
                    android:id="@+id/miniPhone"
                    android:layout_width="124dp"
                    android:layout_height="218dp"
                    android:importantForAccessibility="noHideDescendants"
                    android:orientation="vertical"
                    tools:ignore="SmallSp,UseCompoundDrawables">
                    <!-- A phone at roughly a third of its size (SPEC: 124×218), so the type is tiny on purpose. -->

                    <LinearLayout
                        android:id="@+id/miniAddress"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="7dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <ImageView
                            android:id="@+id/miniShield"
                            android:importantForAccessibility="no"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/ic_shield" />

                        <TextView
                            android:id="@+id/miniAddressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:maxLines="1"
                            android:text="@string/search_hint"
                            android:textColor="@color/text_hint"
                            android:textSize="6sp" />
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="58dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp">

                        <View
                            android:id="@+id/miniGlow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <ImageView
                            android:id="@+id/miniLogo"
                            android:importantForAccessibility="no"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_beast_logo" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/miniWordmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.14"
                        android:text="@string/app_name"
                        android:textAllCaps="true"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/miniWordmarkSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:letterSpacing="0.3"
                        android:textSize="4.5sp"
                        tools:text="BROWSER · PLAY" />

                    <LinearLayout
                        android:id="@+id/miniSearch"
                        android:layout_width="match_parent"
                        android:layout_height="21dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">

                        <ImageView
                            android:id="@+id/miniSearchIcon"
                            android:importantForAccessibility="no"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@drawable/ic_search" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:maxLines="1"
                            android:id="@+id/miniSearchText"
                            android:textColor="@color/text_hint"
                            android:textSize="5.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_marginTop="9dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/miniDialMarker"
                            android:layout_width="1.5dp"
                            android:layout_height="6dp" />

                        <TextView
                            android:id="@+id/miniDialHeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.12"
                            android:text="@string/appearance_preview_dial"
                            android:textAllCaps="true"
                            android:textColor="@color/text_primary"
                            android:textSize="4.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/miniTiles"
                        android:layout_width="match_parent"
                        android:layout_height="22dp"
                        android:layout_marginStart="7dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="7dp"
                        android:orientation="horizontal" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:id="@+id/miniBar"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <ImageView style="@style/MiniBarIcon" android:src="@drawable/ic_back" android:importantForAccessibility="no" />
                        <ImageView style="@style/MiniBarIcon" android:src="@drawable/ic_forward" android:importantForAccessibility="no" />
                        <ImageView style="@style/MiniBarIcon" android:src="@drawable/ic_home" android:importantForAccessibility="no" />

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1">

                            <TextView
                                android:id="@+id/miniTabCount"
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/text_primary"
                                android:textSize="5.5sp"
                                android:textStyle="bold"
                                tools:text="3" />
                        </FrameLayout>

                        <ImageView
                            android:id="@+id/miniMenuWolf"
                            android:importantForAccessibility="no"
                            style="@style/MiniBarIcon"
                            android:src="@drawable/ic_beast_logo" />
                    </LinearLayout>
                </LinearLayout>

                <!-- What recolours -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    tools:ignore="SmallSp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_preview_blurb"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <FrameLayout
                        android:id="@+id/previewNewTabBox"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/previewNewTab"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawablePadding="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="no"
                            android:text="@string/appearance_preview_new_tab"
                            android:textSize="13sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/appearance_preview_shields"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/previewSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/previewChipShields"
                            style="@style/PreviewChip"
                            android:text="@string/appearance_preview_shields_chip" />

                        <TextView
                            android:id="@+id/previewChipRealm"
                            style="@style/PreviewChip"
                            android:layout_marginStart="6dp"
                            tools:text="Play" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/appearance_preview_loading"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/previewPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="10sp"
                            tools:text="62%" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/previewProgressTrack"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal"
                        android:weightSum="100">

                        <View
                            android:id="@+id/previewProgress"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="62" />
                    </LinearLayout>

                    <!-- Tab-card strip: gradient top edge, then a tab row -->
                    <LinearLayout
                        android:id="@+id/previewTabCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/previewTabStrip"
                            android:layout_width="match_parent"
                            android:layout_height="3dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="28dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:id="@+id/previewTabIcon"
                                android:importantForAccessibility="no"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_beast_logo" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:maxLines="1"
                                android:text="@string/appearance_preview_new_tab"
                                android:textColor="@color/text_primary"
                                android:textSize="11sp" />

                            <ImageView
                                android:importantForAccessibility="no"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:src="@drawable/ic_close"
                                app:tint="@color/text_secondary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ============================================================ MODE -->
            <include android:id="@+id/headerMode" layout="@layout/view_section_header" />

            <LinearLayout
                android:id="@+id/modeRow"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal" />

            <!-- ============================================================ ACCENT THEME -->
            <include android:id="@+id/headerAccent" layout="@layout/view_section_header" />

            <GridLayout
                android:id="@+id/presetGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <!-- ============================================================ REALM ACCENTS -->
            <include android:id="@+id/headerRealms" layout="@layout/view_section_header" />

            <LinearLayout
                android:id="@+id/realmRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <!-- ============================================================ MOTION (item 19) -->
            <include android:id="@+id/headerMotion" layout="@layout/view_section_header" />

            <LinearLayout
                android:id="@+id/wolfRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/wolfTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/appearance_wolf_title"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/wolfSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/wolfSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
