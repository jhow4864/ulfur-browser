<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 2.12: 56dp plate; a real site icon (32dp, tileImage) sits on it, the letter (tileIcon) is the fallback. -->
    <FrameLayout
        android:id="@+id/tilePlate"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/tileIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_tile"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:textColor="?attr/colorPrimary"
            android:textSize="22sp"
            tools:text="Y" />

        <ImageView
            android:id="@+id/tileImage"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tileLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxWidth="76dp"
        android:singleLine="true"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        tools:text="YouTube" />
</LinearLayout>
