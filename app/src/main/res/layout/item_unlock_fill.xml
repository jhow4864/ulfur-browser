<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="8dp">

    <TextView
        android:id="@+id/unlockAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_menu_icon"
        android:fontFamily="sans-serif-black"
        android:gravity="center"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        tools:text="E" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/unlockUsername"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:text="jam@example.com" />

        <TextView
            android:id="@+id/unlockAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/unlock_to_fill"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/unlockFingerprint"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_fingerprint"
        app:tint="?attr/colorPrimary"
        tools:ignore="ContentDescription" />
</LinearLayout>
