<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radarRoot"
    android:background="#cc0e0e12"
    android:focusable="true"
    android:visibility="gone"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/radarStage"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">
        <TextView
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:id="@+id/radarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/media_radar"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:id="@+id/radarCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:layout_marginEnd="8dp" />
        <ImageButton
            android:id="@+id/radarClose"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            app:tint="@color/text_primary"
            style="@style/BeastIconButton" />
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/text_hint"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/radarEmpty"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/media_radar_empty" />
</FrameLayout>
