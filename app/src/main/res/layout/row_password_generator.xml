<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/generatorRow"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/password_generator"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.06" />
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            android:ellipsize="middle"
            android:id="@+id/generatedPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:fontFamily="monospace" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/useGenerated"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="@string/use_this"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textAllCaps="false"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:cornerRadius="18dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.slider.Slider
            android:value="16"
            android:id="@+id/lengthSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:layout_weight="1"
            android:valueFrom="8"
            android:valueTo="32"
            app:haloColor="?attr/colorPrimary"
            app:thumbColor="?attr/colorPrimary"
            app:trackColorActive="?attr/colorPrimary"
            app:trackColorInactive="@color/track_muted" />
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="end"
            android:id="@+id/lengthLabel"
            android:layout_width="36dp"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
