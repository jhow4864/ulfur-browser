<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/switcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/switcherMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedButton="@+id/modeNormal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeNormal"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tabs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modePrivate"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/private_tabs"
                app:icon="@drawable/ic_incognito"
                app:iconSize="16dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeAll"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/close_all"
            android:textColor="@color/text_secondary" />

        <ImageButton
            android:id="@+id/switcherClose"
            style="@style/BeastIconButton"
            android:contentDescription="Done"
            android:src="@drawable/ic_check"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 2.3.5: tab search + tab-group filter pills -->
    <include
        android:id="@+id/tabSearch"
        layout="@layout/view_tab_search" />

    <HorizontalScrollView
        android:id="@+id/tabGroupStripScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/tabGroupStrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="96dp" />

        <!-- 2.3.4: illustrated empty state (img_empty_tabs / empty_tabs_*) -->
        <include
            android:id="@+id/switcherEmpty"
            layout="@layout/view_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/newTabFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:text="@string/new_tab"
            app:icon="@drawable/ic_add" />
    </FrameLayout>
</LinearLayout>
