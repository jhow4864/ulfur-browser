        <item name="colorTertiary">#A63BFF</item><item name="colorAccent">#A63BFF</item>
        <item name="colorOnPrimary">#FFFFFF</item><item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#F4E7FF</item><item name="colorSecondaryContainer">#F4E7FF</item>
        <item name="ulfurAccentStart">#9C33FF</item><item name="ulfurAccentEnd">#5A4BFF</item>
        <item name="ulfurAccent">#A63BFF</item><item name="ulfurOnAccent">#FFFFFF</item>
