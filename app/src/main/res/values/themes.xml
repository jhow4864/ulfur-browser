<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Beast.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/gx_red</item>
        <item name="colorOnPrimary">#0E0E12</item>
        <item name="colorPrimaryContainer">#FFD9DF</item>
        <item name="colorOnPrimaryContainer">#3A0A18</item>
        <item name="colorSecondary">@color/gx_red</item>
        <item name="colorOnSecondary">#0E0E12</item>
        <item name="colorSecondaryContainer">#FFE8EC</item>
        <item name="colorOnSecondaryContainer">#3A0A18</item>
        <item name="colorTertiary">@color/gx_red</item>
        <item name="colorAccent">@color/gx_red</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
        <item name="colorSurfaceContainerHighest">@color/surface3</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorOutlineVariant">@color/stroke</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Beast.BottomSheet</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Beast.Dialog</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <!-- 2.8 tokens default to Blood Moon; activities apply their realm's ThemeOverlay.Ulfur.Preset.* on top. -->
        <item name="ulfurAccentStart">#FF2D55</item><item name="ulfurAccentEnd">#E040FB</item>
        <item name="ulfurAccent">#FF2D55</item><item name="ulfurOnAccent">#0E0E12</item>
        <item name="ulfurAccentText">#EA002D</item><item name="ulfurSurfaceTint">#FFE6EB</item>
        <item name="ulfurEye">#FF7A9A</item>
    </style>

    <!-- Android 8.0 (API 26) can't draw dark navigation bar icons (windowLightNavigationBar is API 27+), so a light
         bar there would hide its white icons. Use a black bar on 26; values-v27 switches to the light bar. -->
    <style name="Theme.Beast" parent="Theme.Beast.Base">
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- Sheets: same API 26 rule as Theme.Beast (black bar here, @color/surface from values-v27). -->
    <style name="ThemeOverlay.Beast.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Beast.BottomSheet</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Widget.Beast.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/surface</item>
    </style>
    <style name="ThemeOverlay.Beast.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface2</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
    </style>

    <!-- 2.8 accent theme presets (Designer's SPEC.md / themes.json; data/ThemePreset.kt). Applied at runtime with
         theme.applyStyle() like the 2.3–2.5 accent overlays. Light mode: accentText/surfaceTint use the light tokens.
         Every preset sets the same attributes, so re-applying one fully replaces another (no recreate needed). -->
    <style name="ThemeOverlay.Ulfur.Preset" parent="" />
    <style name="ThemeOverlay.Ulfur.Preset.BloodMoon">
        <item name="colorPrimary">#FF2D55</item><item name="colorSecondary">#FF2D55</item>
        <item name="colorTertiary">#FF2D55</item><item name="colorAccent">#FF2D55</item>
        <item name="colorOnPrimary">#0E0E12</item><item name="colorOnSecondary">#0E0E12</item>
        <item name="colorPrimaryContainer">#FFE6EB</item><item name="colorSecondaryContainer">#FFE6EB</item>
        <item name="ulfurAccentStart">#FF2D55</item><item name="ulfurAccentEnd">#E040FB</item>
        <item name="ulfurAccent">#FF2D55</item><item name="ulfurOnAccent">#0E0E12</item>
        <item name="ulfurAccentText">#EA002D</item><item name="ulfurSurfaceTint">#FFE6EB</item>
        <item name="ulfurEye">#FF7A9A</item>
    </style>
    <style name="ThemeOverlay.Ulfur.Preset.Frost">
        <item name="colorPrimary">#00E1FF</item><item name="colorSecondary">#00E1FF</item>
        <item name="colorTertiary">#00E1FF</item><item name="colorAccent">#00E1FF</item>
        <item name="colorOnPrimary">#0E0E12</item><item name="colorOnSecondary">#0E0E12</item>
        <item name="colorPrimaryContainer">#E0FBFF</item><item name="colorSecondaryContainer">#E0FBFF</item>
        <item name="ulfurAccentStart">#00E1FF</item><item name="ulfurAccentEnd">#3D7BFF</item>
        <item name="ulfurAccent">#00E1FF</item><item name="ulfurOnAccent">#0E0E12</item>
        <item name="ulfurAccentText">#008294</item><item name="ulfurSurfaceTint">#E0FBFF</item>
        <item name="ulfurEye">#3D7BFF</item>
    </style>
    <style name="ThemeOverlay.Ulfur.Preset.Toxic">
        <item name="colorPrimary">#2BFF88</item><item name="colorSecondary">#2BFF88</item>
        <item name="colorTertiary">#2BFF88</item><item name="colorAccent">#2BFF88</item>
        <item name="colorOnPrimary">#0E0E12</item><item name="colorOnSecondary">#0E0E12</item>
        <item name="colorPrimaryContainer">#E6FFF1</item><item name="colorSecondaryContainer">#E6FFF1</item>
        <item name="ulfurAccentStart">#2BFF88</item><item name="ulfurAccentEnd">#C8FF2E</item>
        <item name="ulfurAccent">#2BFF88</item><item name="ulfurOnAccent">#0E0E12</item>
        <item name="ulfurAccentText">#00873B</item><item name="ulfurSurfaceTint">#E6FFF1</item>
        <item name="ulfurEye">#C8FF2E</item>
    </style>
    <style name="ThemeOverlay.Ulfur.Preset.Ember">
        <item name="colorPrimary">#FF7A1A</item><item name="colorSecondary">#FF7A1A</item>
        <item name="colorTertiary">#FF7A1A</item><item name="colorAccent">#FF7A1A</item>
        <item name="colorOnPrimary">#0E0E12</item><item name="colorOnSecondary">#0E0E12</item>
        <item name="colorPrimaryContainer">#FFEFE4</item><item name="colorSecondaryContainer">#FFEFE4</item>
        <item name="ulfurAccentStart">#FFA41B</item><item name="ulfurAccentEnd">#FF4E1A</item>
        <item name="ulfurAccent">#FF7A1A</item><item name="ulfurOnAccent">#0E0E12</item>
