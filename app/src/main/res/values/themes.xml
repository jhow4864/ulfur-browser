        <item name="colorTertiary">#FFC233</item><item name="colorAccent">#FFC233</item>
        <item name="colorOnPrimary">#0E0E12</item><item name="colorOnSecondary">#0E0E12</item>
        <item name="colorPrimaryContainer">#FFF8E7</item><item name="colorSecondaryContainer">#FFF8E7</item>
        <item name="ulfurAccentStart">#FFD54A</item><item name="ulfurAccentEnd">#FF9F1C</item>
        <item name="ulfurAccent">#FFC233</item><item name="ulfurOnAccent">#0E0E12</item>
