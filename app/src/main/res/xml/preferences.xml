<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Shields" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="block_ads" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="@string/shields_brand"
            app:summary="Firefox Enhanced Tracking Protection (Strict): ads, analytics, social, cryptominers, fingerprinters, email trackers" />
        <SwitchPreferenceCompat app:key="ublock" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="uBlock Origin (built in)"
            app:summary="Full uBO content blocker with its default filter lists, incl. YouTube ad blocking" />
        <Preference app:key="ublock_dashboard" app:iconSpaceReserved="false"
            app:title="uBlock Origin dashboard" app:summary="Filter lists, my filters, trusted sites" />
        <Preference app:key="reset_counter" app:iconSpaceReserved="false" app:title="Reset blocked counter" />
        <Preference app:key="tracker_tally" app:iconSpaceReserved="false" app:title="@string/pref_tally_title"
            app:fragment="com.jamhowman.beastbrowser.ui.TrackerTallyFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Privacy &amp; security" app:iconSpaceReserved="false">
        <ListPreference app:key="https_mode" app:defaultValue="all" app:iconSpaceReserved="false"
            app:title="HTTPS-Only mode" app:useSimpleSummaryProvider="true"
            app:entries="@array/https_mode_names" app:entryValues="@array/https_mode_keys" />
        <Preference app:key="secure_dns" app:iconSpaceReserved="false" app:title="@string/pref_doh_title"
            app:fragment="com.jamhowman.beastbrowser.ui.SecureDnsFragment" />
        <ListPreference app:key="cookie_mode" app:defaultValue="tcp" app:iconSpaceReserved="false"
            app:title="Cookie protection" app:useSimpleSummaryProvider="true"
            app:entries="@array/cookie_mode_names" app:entryValues="@array/cookie_mode_keys" />
        <SwitchPreferenceCompat app:key="dnt_gpc" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="Global Privacy Control"
            app:summary="Sends Sec-GPC: 1 and sets navigator.globalPrivacyControl" />
        <SwitchPreferenceCompat app:key="fingerprinting" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="Fingerprinting protection" app:summary="Firefox's fingerprinting resistance (always on in private tabs)" />
        <SwitchPreferenceCompat app:key="safe_browsing" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="Safe Browsing" app:summary="Warn about known phishing and malware sites" />
        <SwitchPreferenceCompat app:key="clear_on_exit" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="Clear data on exit" app:summary="@string/pref_clear_on_exit_summary" />
        <Preference app:key="clear_now" app:iconSpaceReserved="false" app:title="Clear browsing data now" />
        <Preference app:key="passwords" app:iconSpaceReserved="false"
            app:title="Passwords"
            app:summary="Encrypted saved logins unlocked with your fingerprint" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Search" app:iconSpaceReserved="false">
        <ListPreference app:key="search_engine" app:defaultValue="ddg" app:iconSpaceReserved="false"
            app:title="Search engine" app:useSimpleSummaryProvider="true"
            app:entries="@array/search_engine_names" app:entryValues="@array/search_engine_keys" />
        <SwitchPreferenceCompat app:key="search_suggestions" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="Search suggestions"
            app:summary="Live suggestions from your search engine as you type. Never sent from private tabs or for web addresses." />
    </PreferenceCategory>

    <PreferenceCategory app:title="Appearance" app:iconSpaceReserved="false">
        <!-- 2.8: mode (ui_theme), theme presets and realm accents live on their own screen (roadmap item 18). -->
        <Preference app:key="appearance" app:iconSpaceReserved="false" app:title="@string/pref_appearance_title"
            app:fragment="com.jamhowman.beastbrowser.ui.AppearanceFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_browsing" app:iconSpaceReserved="false">
        <Preference app:key="site_content" app:iconSpaceReserved="false" app:title="@string/pref_site_content_title"
            app:fragment="com.jamhowman.beastbrowser.ui.SiteContentFragment" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_category_backup" app:iconSpaceReserved="false">
        <Preference app:key="backup_export" app:iconSpaceReserved="false" app:title="@string/pref_backup_export_title"
            app:summary="@string/pref_backup_export_summary" />
        <Preference app:key="backup_import" app:iconSpaceReserved="false" app:title="@string/pref_backup_import_title"
            app:summary="@string/pref_backup_import_summary" />
    </PreferenceCategory>

    <!-- 2.5.1: opt-in crash reports (crash/CrashReporter.kt, ui/CrashReportUi.kt). Off by default. -->
    <PreferenceCategory app:title="@string/pref_category_crash" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="crash_reports" app:defaultValue="false" app:iconSpaceReserved="false"
            app:title="@string/pref_crash_reports_title" app:summary="@string/pref_crash_reports_summary" />
        <Preference app:key="crash_reports_saved" app:iconSpaceReserved="false" app:title="@string/pref_crash_saved_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="General" app:iconSpaceReserved="false">
        <Preference app:key="downloads" app:iconSpaceReserved="false" app:title="Downloads"
            app:summary="@string/pref_downloads_summary" />
        <SwitchPreferenceCompat app:key="restore_tabs" app:defaultValue="true" app:iconSpaceReserved="false"
            app:title="Restore tabs on start" app:summary="Normal tabs only. Private tabs are never saved" />
        <Preference app:key="check_updates" app:iconSpaceReserved="false" app:title="Check for updates" />
        <Preference app:key="about" app:iconSpaceReserved="false" app:title="@string/about_title" />
    </PreferenceCategory>
</PreferenceScreen>
